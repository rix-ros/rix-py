{
  "title": "JRDF",
  "description": "The JSON Robot Description Format (JRDF) is a JSON-based format for describing the structure and properties of robots.",
  "type": "object",
  "$defs": {
    "name": {
      "type": "string",
      "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"
    },
    "number_or_expression": {
      "oneOf": [
        {
          "type": "number"
        },
        {
          "type": "string"
        }
      ]
    },
    "vector3": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/number_or_expression"
      },
      "minItems": 3,
      "maxItems": 3
    },
    "vector4": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/number_or_expression"
      },
      "minItems": 4,
      "maxItems": 4
    },
    "origin": {
      "type": "object",
      "properties": {
        "xyz": {
          "$ref": "#/$defs/vector3"
        },
        "rpy": {
          "$ref": "#/$defs/vector3"
        }
      },
      "required": ["xyz", "rpy"],
      "default": {
        "xyz": [0, 0, 0],
        "rpy": [0, 0, 0]
      }
    },
    "geometry": {
      "type": "object",
      "oneOf": [
        {
          "properties": {
            "type": {
              "const": "box"
            },
            "size": {
              "$ref": "#/$defs/vector3"
            }
          },
          "required": ["type", "size"]
        },
        {
          "properties": {
            "type": {
              "const": "cylinder"
            },
            "radius": {
              "$ref": "#/$defs/number_or_expression"
            },
            "length": {
              "$ref": "#/$defs/number_or_expression"
            }
          },
          "required": ["type", "radius", "length"]
        },
        {
          "properties": {
            "type": {
              "const": "sphere"
            },
            "radius": {
              "$ref": "#/$defs/number_or_expression"
            }
          },
          "required": ["type", "radius"]
        },
        {
          "properties": {
            "type": {
              "const": "mesh"
            },
            "filename": {
              "type": "string"
            },
            "scale": {
              "$ref": "#/$defs/vector3",
              "default": [1, 1, 1]
            }
          },
          "required": ["type", "filename"]
        }
      ]
    },
    "material_global": {
      "type": "object",
      "oneOf": [
        {
          "properties": {
            "name": {
              "$ref": "#/$defs/name"
            },
            "color": {
              "$ref": "#/$defs/vector4"
            }
          },
          "required": ["name", "color"]
        },
        {
          "properties": {
            "name": {
              "$ref": "#/$defs/name"
            },
            "texture_filename": {
              "type": "string"
            }
          },
          "required": ["name", "texture_filename"]
        }
      ]
    },
    "material_internal": {
      "type": "object",
      "oneOf": [
        {
          "properties": {
            "color": {
              "$ref": "#/$defs/vector4"
            }
          },
          "required": ["color"]
        },
        {
          "properties": {
            "texture_filename": {
              "type": "string"
            }
          },
          "required": ["texture_filename"]
        },
        {
          "properties": {
            "name": {
              "type": "string"
            }
          },
          "required": ["name"]
        }
      ]
    }
  },
  "properties": {
    "name": {
      "description": "The name of the robot.",
      "$ref": "#/$defs/name"
    },
    "constants": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "$ref": "#/$defs/name"
          },
          "value": {
            "type": "number"
          }
        },
        "required": ["name", "value"]
      }
    },
    "materials": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/material_global"
      }
    },
    "joints": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "$ref": "#/$defs/name"
          },
          "parent": {
            "$ref": "#/$defs/name"
          },
          "child": {
            "$ref": "#/$defs/name"
          },
          "type": {
            "type": "string",
            "enum": ["fixed", "revolute", "continuous", "prismatic"]
          },
          "origin": {
            "$ref": "#/$defs/origin"
          },
          "axis": {
            "$ref": "#/$defs/vector3",
            "default": [1, 0, 0]
          },
          "limits": {
            "type": "object",
            "properties": {
              "lower": {
                "$ref": "#/$defs/number_or_expression"
              },
              "upper": {
                "$ref": "#/$defs/number_or_expression"
              },
              "effort": {
                "$ref": "#/$defs/number_or_expression"
              },
              "velocity": {
                "$ref": "#/$defs/number_or_expression"
              }
            },
            "required": ["lower", "upper", "effort", "velocity"]
          },
          "dynamics": {
            "type": "object",
            "properties": {
              "damping": {
                "$ref": "#/$defs/number_or_expression"
              },
              "friction": {
                "$ref": "#/$defs/number_or_expression"
              }
            },
            "required": ["damping", "friction"]
          },
          "safety": {
            "type": "object",
            "properties": {
              "soft_lower_limit": {
                "$ref": "#/$defs/number_or_expression"
              },
              "soft_upper_limit": {
                "$ref": "#/$defs/number_or_expression"
              },
              "k_position": {
                "$ref": "#/$defs/number_or_expression"
              },
              "k_velocity": {
                "$ref": "#/$defs/number_or_expression"
              }
            },
            "required": [
              "soft_lower_limit",
              "soft_upper_limit",
              "k_position",
              "k_velocity"
            ]
          }
        },
        "required": ["name", "parent", "child", "type"],
        "if": {
          "properties": {
            "type": {
              "enum": ["revolute", "prismatic", "continuous"]
            }
          }
        },
        "then": {
          "required": ["axis"],
          "if": {
            "properties": {
              "type": {
                "enum": ["revolute", "prismatic"]
              }
            }
          },
          "then": {
            "required": ["limits"]
          },
          "else": {
            "properties": {
              "limits": false
            }
          }
        },
        "else": {
          "properties": {
            "axis": false,
            "limits": false,
            "dynamics": false,
            "safety": false
          }
        }
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "$ref": "#/$defs/name"
          },
          "inertial": {
            "type": "object",
            "properties": {
              "mass": {
                "$ref": "#/$defs/number_or_expression"
              },
              "inertia": {
                "type": "object",
                "properties": {
                  "ixx": {
                    "$ref": "#/$defs/number_or_expression"
                  },
                  "iyy": {
                    "$ref": "#/$defs/number_or_expression"
                  },
                  "izz": {
                    "$ref": "#/$defs/number_or_expression"
                  },
                  "ixy": {
                    "$ref": "#/$defs/number_or_expression"
                  },
                  "ixz": {
                    "$ref": "#/$defs/number_or_expression"
                  },
                  "iyz": {
                    "$ref": "#/$defs/number_or_expression"
                  }
                },
                "required": ["ixx", "iyy", "izz", "ixy", "ixz", "iyz"]
              },
              "origin": {
                "$ref": "#/$defs/origin"
              }
            },
            "required": ["mass", "inertia", "origin"]
          },
          "visuals": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "geometry": {
                  "$ref": "#/$defs/geometry"
                },
                "origin": {
                  "$ref": "#/$defs/origin"
                },
                "material": {
                  "$ref": "#/$defs/material_internal"
                }
              },
              "required": ["geometry"]
            }
          },
          "collisions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "geometry": {
                  "$ref": "#/$defs/geometry"
                },
                "origin": {
                  "$ref": "#/$defs/origin"
                }
              },
              "required": ["geometry"]
            }
          }
        },
        "required": ["name"]
      }
    }
  },
  "required": ["name", "joints", "links"]
}
